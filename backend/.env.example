# Obligatoria: el sistema no arranca sin ella. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=postgresql+psycopg://tikray:tikray@localhost:5432/tikray
# Dominio base: cada colegio entra por <subdominio>.<DOMINIO_BASE>.
# En local, *.localhost apunta a 127.0.0.1 (ej. demo.localhost:5173).
DOMINIO_BASE=localhost
# Archivos (logos). Disco local por ahora; S3 cuando se elija proveedor.
CARPETA_ARCHIVOS=archivos
