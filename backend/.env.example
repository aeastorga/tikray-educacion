# Obligatoria: el sistema no arranca sin ella. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=postgresql+psycopg://tikray:tikray@localhost:5432/tikray
# Dominio base: cada colegio entra por <subdominio>.<DOMINIO_BASE>.
# En local, *.localhost apunta a 127.0.0.1 (ej. demo.localhost:5173).
DOMINIO_BASE=localhost
# Archivos (logos). Disco local por ahora; S3 cuando se elija proveedor.
CARPETA_ARCHIVOS=archivos
# Redes de los proxies propios (CIDR, separadas por comas). Solo de ellas se
# acepta X-Forwarded-For para saber la IP real. Vacío = se usa la IP directa.
# Pon aquí la red del balanceador de Render/Vercel cuando se despliegue.
PROXIES_CONFIANZA=
# Faltas automáticas cada minuto dentro del servidor (false para apagarlas).
TAREAS_EN_FONDO=true
# Notificaciones push a las familias (genéralas con: python -m app.cli claves-push).
# Sin ellas los avisos se quedan en la cola sin enviar.
VAPID_CLAVE_PRIVADA=
VAPID_CLAVE_PUBLICA=
VAPID_CONTACTO=mailto:soporte@tikraylabs.pe
